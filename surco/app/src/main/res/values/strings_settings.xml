    <!-- Acerca de -->
    <string name="settings_privacy">Privacy</string>
    <string name="settings_privacy_online">Surco only goes online to look up lyrics on lrclib.net (artist, title, album and duration). Plays, favorites, playlists and settings stay on this phone.</string>
    <string name="settings_privacy_offline">Surco doesn\'t use the internet. Plays, favorites, playlists and settings stay on this phone.</string>
    <string name="settings_version">Version</string>
    <string name="settings_formats">Formats</string>
    <string name="settings_formats_help">MP3, AAC, FLAC, ALAC, Opus, Vorbis and WAV (floating point too). Lyrics from the LYRICS tag or from a .lrc file next to the song.</string>
    <string name="settings_accent_system">From system</string>
    <string name="settings_language_section">Language</string>
    <string name="settings_language_system">Phone\'s language</string>
    <string name="settings_usb_title">Bit-perfect over USB</string>
    <string name="settings_usb_help">With a USB DAC: each song at its own rate, untouched. Volume moves to the DAC.</string>
    <string name="settings_usb_old">Needs Android 14 or later.</string>
    <string name="settings_privacy_lb">ListenBrainz is on: each play (artist, title, album and duration) is sent to listenbrainz.org with your token.</string>
    <string name="settings_eq_per_output">An equalizer for each output</string>
    <string name="settings_eq_per_output_help">Each headphone, speaker or DAC remembers its own curve.</string>
    <string name="settings_system_fx">Phone sound effects</string>
    <string name="settings_system_fx_help">Xiaomi Sound, Dolby…: applied after Surco, they add no bits.</string>
