    </plurals>
    <string name="settings_analyze_help">For songs whose tags lack them. Loudness evens out the volume with ReplayGain on. Done: %1$d.</string>
    <string name="settings_lrclib">Online lyrics (LRCLIB)</string>
    <string name="settings_lrclib_help">If a song has no lyrics, they\'re looked up on lrclib.net (many are synced). Only artist, title, album and duration are sent.</string>
    <string name="settings_folders">Folders</string>
    <string name="settings_folders_help">Folders turned off don\'t show up in the library or in search. Nothing is deleted.</string>

