<!-- Widget grande (4×2): portada grande, títulos y favorita arriba; mandos abajo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_bg"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="12dp">
        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="match_parent"
            android:background="@drawable/w_art_bg">
            <ImageView
                android:id="@+id/w_note"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/w_note" />
            <ImageView
                android:id="@+id/w_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />
        </FrameLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="4dp"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <!-- RelativeLayout: los títulos ocupan lo que deja la favorita sin pesos anidados. -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/w_fav"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:padding="12dp"
                android:contentDescription="@string/w_fav"
                android:src="@drawable/w_fav_border" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toStartOf="@id/w_fav"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/w_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/app_name"
                    android:textColor="#FFECE7E1"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/w_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/widget_empty"
                    android:textColor="#FFA3A8B0"
                    android:textSize="13sp" />
            </LinearLayout>
        </RelativeLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:baselineAligned="false"
            android:orientation="horizontal">
        <ImageView
            android:id="@+id/w_prev"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:contentDescription="@string/w_prev"
            android:src="@drawable/w_prev" />
        <FrameLayout
            android:id="@+id/w_play_box"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/w_play_pause">
            <ImageView
                android:id="@+id/w_play_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/w_circle" />
            <ImageView
                android:id="@+id/w_play"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/w_play" />
        </FrameLayout>
        <ImageView
            android:id="@+id/w_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:contentDescription="@string/w_next"
            android:src="@drawable/w_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
