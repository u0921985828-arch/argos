    <string name="settings_privacy">Privacidad</string>
    <string name="settings_privacy_online">Surco solo usa internet para buscar letras en lrclib.net (artista, título, álbum y duración). Las escuchas, favoritas, listas y ajustes se guardan solo en este móvil.</string>
